.container {
  padding: 20rpx;
}

.summary-card {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.summary-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.summary-amount {
  font-size: 64rpx;
  font-weight: bold;
}

.summary-grid {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 30rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.item-value {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.item-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.available-row {
  display: flex;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.available-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.available-amount {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  text-align: left;
  margin-left: 20rpx;
}

.withdraw-btn {
  background: #fff;
  color: #ff6b6b;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 56rpx;
  line-height: 56rpx;
  border: none;
  margin: 0;
}

.withdraw-btn::after {
  border: none;
}

.period-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.period-tab.active {
  background: #ff6b6b;
  color: #fff;
  font-weight: bold;
}

.records-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.records-list {
  min-height: 400rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-icon.income {
  background: #e8f5e9;
}

.record-icon.withdraw {
  background: #ffebee;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #4caf50;
}

.record-amount.income {
  color: #4caf50;
}

.record-amount.withdraw {
  color: #ff6b6b;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.load-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}
