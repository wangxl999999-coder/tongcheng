.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 40rpx 30rpx 80rpx;
  color: #fff;
}

.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  opacity: 0.9;
}

.edit-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.store-brief {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
}

.store-name {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}

.store-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.store-status.open {
  background: rgba(76, 175, 80, 0.4);
}

.stats-row {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: -40rpx 20rpx 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 50rpx;
  background: #f0f0f0;
}

.menu-groups {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.menu-group {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.contact-section {
  padding: 0 20rpx;
  margin-bottom: 40rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.contact-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.logout-section {
  padding: 0 20rpx;
  margin-bottom: 40rpx;
}

.logout-btn {
  width: 100%;
  background: #fff;
  color: #ff6b6b;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.logout-btn::after {
  border: none;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 20rpx 0 40rpx;
}
