<view class="container">
  <view class="header">
    <view class="store-info" wx:if="{{storeInfo}}">
      <image class="store-logo" src="{{storeInfo.logo}}" mode="aspectFill"></image>
      <view class="store-detail">
        <view class="store-name">{{storeInfo.name}}</view>
        <view class="store-status {{storeInfo.status === 1 ? 'open' : 'close'}}">
          {{storeInfo.status === 1 ? '营业中' : '已打烊'}}
        </view>
      </view>
      <view class="store-edit" bindtap="onStoreInfo">
        <text>管理</text>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-value">{{stats.todayOrders}}</view>
        <view class="stats-label">今日订单</view>
      </view>
      <view class="stats-item">
        <view class="stats-value price">¥{{stats.todayAmount}}</view>
        <view class="stats-label">今日营收</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{stats.pendingOrders}}</view>
        <view class="stats-label">待处理</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{stats.pendingVerify}}</view>
        <view class="stats-label">待核销</view>
      </view>
    </view>
  </view>

  <view class="week-stats">
    <view class="week-item">
      <view class="week-label">本周订单</view>
      <view class="week-value">{{stats.weekOrders}} 单</view>
    </view>
    <view class="week-divider"></view>
    <view class="week-item">
      <view class="week-label">本周营收</view>
      <view class="week-value price">¥{{stats.weekAmount}}</view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-item" bindtap="onVerify">
      <view class="action-icon">📱</view>
      <view class="action-label">扫码核销</view>
    </view>
    <view class="action-item" bindtap="onViewAllOrders">
      <view class="action-icon">📋</view>
      <view class="action-label">订单管理</view>
    </view>
    <view class="action-item" bindtap="onIncome">
      <view class="action-icon">💰</view>
      <view class="action-label">收入统计</view>
    </view>
    <view class="action-item" bindtap="onStoreInfo">
      <view class="action-icon">🏪</view>
      <view class="action-label">门店管理</view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">最近订单</view>
      <view class="section-more" bindtap="onViewAllOrders">查看全部 ›</view>
    </view>

    <view class="order-list" wx:if="{{!loading}}">
      <view 
        class="order-item" 
        wx:for="{{recentOrders}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOrderDetail"
      >
        <view class="order-header">
          <view class="order-no">{{item.order_no}}</view>
          <view class="order-status" style="color: {{item.status_color}}">
            {{item.status_text}}
          </view>
        </view>

        <view class="order-info">
          <image class="service-image" src="{{item.service_image}}" mode="aspectFill"></image>
          <view class="service-detail">
            <view class="service-name">{{item.service_name}}</view>
            <view class="service-time">{{item.appointment_time}}</view>
            <view class="user-info">
              <text>{{item.user_name}}</text>
              <text class="user-phone">{{item.user_phone}}</text>
            </view>
          </view>
          <view class="order-amount">
            <text class="price">¥{{item.amount}}</text>
          </view>
        </view>

        <view class="order-actions" catchtap="noop">
          <button 
            class="action-btn primary" 
            wx:if="{{item.status === 1}}"
            catchtap="onDispatchOrder"
            data-id="{{item.id}}"
          >
            立即派单
          </button>
        </view>
      </view>

      <view class="empty" wx:if="{{recentOrders.length === 0}}">
        <text>暂无订单</text>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
