.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #ff6b6b 0%, #ff8e8e 50%, #f5f5f5 100%);
  padding: 0;
}

.header {
  text-align: center;
  padding: 120rpx 0 80rpx;
  color: #fff;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.login-box {
  margin: 0 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.tab-bar {
  display: flex;
  margin-bottom: 50rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.form-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
}

.code-btn {
  background: #ffebee;
  color: #ff6b6b;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border: none;
  margin-left: 20rpx;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  background: #f5f5f5;
  color: #999;
}

.login-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  margin-top: 40rpx;
}

.login-btn::after {
  border: none;
}

.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.checkbox-label {
  display: flex;
  align-items: center;
}

.checkbox-label checkbox {
  transform: scale(0.8);
  margin-right: 8rpx;
}

.agreement-text {
  color: #999;
}

.agreement-link {
  color: #ff6b6b;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.wx-btn {
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-btn::after {
  border: none;
}

.wx-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
