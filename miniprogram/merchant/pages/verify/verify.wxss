.container {
  padding: 0;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.verify-panel {
  padding: 30rpx;
}

.scan-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 2rpx dashed #ff6b6b;
}

.scan-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.scan-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.scan-tip {
  font-size: 24rpx;
  color: #999;
}

.divider {
  text-align: center;
  padding: 30rpx 0;
}

.divider-text {
  font-size: 24rpx;
  color: #999;
  position: relative;
  padding: 0 20rpx;
}

.divider-text::before,
.divider-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 100rpx;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text::before {
  right: 100%;
}

.divider-text::after {
  left: 100%;
}

.input-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.input-row {
  display: flex;
  gap: 20rpx;
}

.input-field {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.query-btn {
  background: #ff6b6b;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  margin: 0;
}

.query-btn::after {
  border: none;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 30rpx;
  overflow: hidden;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-body {
  padding: 24rpx 30rpx;
}

.order-no {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.order-info-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.service-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  min-width: 0;
}

.service-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.service-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.appointment-time {
  font-size: 24rpx;
  color: #666;
}

.user-row {
  font-size: 26rpx;
  color: #333;
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}

.user-phone {
  margin-left: 20rpx;
  color: #999;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 36rpx;
  font-weight: bold;
}

.result-footer {
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
}

.verify-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.verify-btn::after {
  border: none;
}

.verify-btn.disabled {
  background: #ccc;
}

.records-panel {
  padding: 20rpx;
}

.records-list {
  margin-top: 10rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-order-no {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 26rpx;
  font-weight: 500;
}

.record-body {
  display: flex;
  gap: 20rpx;
}

.record-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-service {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.record-user {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
