<view class="container" wx:if="{{!loading}}">
  <view class="logo-section">
    <view class="label">门店Logo</view>
    <view class="logo-upload" bindtap="onChooseLogo">
      <image wx:if="{{form.logo}}" class="logo-preview" src="{{form.logo}}" mode="aspectFill"></image>
      <view wx:else class="logo-placeholder">
        <text class="plus">+</text>
        <text class="text">上传图片</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">门店名称</view>
      <input 
        class="form-input" 
        placeholder="请输入门店名称" 
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input 
        class="form-input" 
        placeholder="请输入联系电话" 
        type="phone"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
      />
    </view>

    <view class="form-item" bindtap="onChooseAddress">
      <view class="form-label">门店地址</view>
      <input 
        class="form-input" 
        placeholder="点击选择门店地址" 
        value="{{form.address}}"
        disabled
      />
      <view class="arrow">›</view>
    </view>

    <view class="form-item">
      <view class="form-label">营业时间</view>
      <input 
        class="form-input" 
        placeholder="如：09:00-21:00" 
        value="{{form.business_hours}}"
        data-field="business_hours"
        bindinput="onInput"
      />
    </view>

    <view class="form-item column">
      <view class="form-label">门店简介</view>
      <textarea 
        class="form-textarea" 
        placeholder="请输入门店简介" 
        value="{{form.description}}"
        data-field="description"
        bindinput="onInput"
        maxlength="500"
      />
    </view>

    <view class="form-item">
      <view class="form-label">营业状态</view>
      <switch 
        checked="{{form.status === 1}}" 
        color="#ff6b6b"
        bindchange="onStatusChange"
      />
    </view>
  </view>

  <view class="submit-section">
    <button 
      class="submit-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '保存中...' : '保存信息'}}
    </button>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
