page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price {
  color: #ff6b6b;
  font-weight: bold;
}

.old-price {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
}

.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.btn-gray {
  background: #f0f0f0;
  color: #666;
}

.btn-block {
  display: block;
  width: 100%;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background: #ffe8e8;
  color: #ff6b6b;
}

.tag-success {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-warning {
  background: #fff8e1;
  color: #ff9800;
}

.tag-info {
  background: #e3f2fd;
  color: #2196f3;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.skeleton {
  background: #f0f0f0;
  border-radius: 8rpx;
  animation: skeleton-loading 1.2s infinite;
}

@keyframes skeleton-loading {
  0%, 100% {
    opacity: 0.6;
  }
  50% {
    opacity: 0.3;
  }
}

.stars {
  display: inline-flex;
  align-items: center;
}

.stars image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}

.input-group {
  background: #fff;
  margin-bottom: 20rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-item:last-child {
  border-bottom: none;
}

.input-item .label {
  width: 160rpx;
  color: #333;
  flex-shrink: 0;
}

.input-item input,
.input-item textarea {
  flex: 1;
  font-size: 28rpx;
}

.input-item .placeholder {
  color: #999;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  margin: 0 6rpx;
  transition: all 0.3s;
}

.swiper-dot.active {
  width: 24rpx;
  background: #fff;
  border-radius: 6rpx;
}
