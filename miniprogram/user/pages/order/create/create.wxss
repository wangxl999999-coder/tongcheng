.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-more {
  font-size: 24rpx;
  color: #ff6b6b;
}

.section-value {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.arrow-right {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.service-section {
  display: flex;
  align-items: center;
}

.service-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.service-spec,
.service-duration {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.service-price {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.service-price .price {
  font-size: 32rpx;
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-item {
  flex: 0 0 calc(50% - 8rpx);
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  text-align: center;
}

.spec-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.spec-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.spec-price {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.type-list {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  text-align: center;
}

.type-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.type-icon {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background-size: 60%;
  background-repeat: no-repeat;
  background-position: center;
}

.icon-home {
  background-color: #ff6b6b;
  background-image: url('/images/type-home.png');
}

.icon-store {
  background-color: #4ecdc4;
  background-image: url('/images/type-store.png');
}

.type-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.type-desc {
  font-size: 22rpx;
  color: #999;
}

.date-scroll {
  white-space: nowrap;
  margin: 0 -24rpx 20rpx;
  padding: 0 24rpx;
}

.date-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.date-item {
  width: 120rpx;
  padding: 16rpx 0;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.date-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.date-week {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.date-month {
  font-size: 22rpx;
  color: #999;
}

.date-item.active .date-week {
  color: #ff6b6b;
}

.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.time-item {
  width: calc(25% - 9rpx);
  padding: 16rpx 0;
  background: #f8f8f8;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.time-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.time-item.disabled {
  background: #f0f0f0;
  color: #ccc;
}

.address-content {
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 26rpx;
  color: #666;
}

.address-tag {
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.address-detail {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.add-address {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.store-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.store-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.store-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.store-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.store-info {
  flex: 1;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.store-address {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.store-phone {
  font-size: 22rpx;
  color: #666;
}

.store-check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

.technician-info {
  display: flex;
  align-items: center;
}

.tech-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tech-detail {
  flex: 1;
}

.tech-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tech-skills {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.tech-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.coupon-selected {
  color: #ff6b6b;
  margin-right: 8rpx;
}

.coupon-available {
  color: #ff6b6b;
  margin-right: 8rpx;
}

.coupon-none {
  color: #999;
  margin-right: 8rpx;
}

.balance-amount {
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #ff6b6b;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-item:last-child {
  border-bottom: none;
}

.input-item .label {
  width: 120rpx;
  color: #333;
  font-size: 26rpx;
}

.input-item input {
  flex: 1;
  font-size: 26rpx;
}

.placeholder {
  color: #999;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.amount-label {
  color: #666;
}

.amount-value {
  color: #333;
}

.amount-value.discount {
  color: #4caf50;
}

.amount-total {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eee;
  margin-top: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.total-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.footer-space {
  height: 120rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-text {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.btn-submit {
  padding: 24rpx 60rpx;
  font-size: 30rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.coupon-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}

.popup-content {
  flex: 1;
  padding: 24rpx;
}

.coupon-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #ff6b6b;
  position: relative;
}

.coupon-item.selected {
  background: linear-gradient(135deg, #ffe8e8 0%, #fff5f5 100%);
  border-left-color: #ff6b6b;
}

.coupon-left {
  width: 160rpx;
  text-align: center;
  padding-right: 20rpx;
  border-right: 2rpx dashed #ffcccc;
  flex-shrink: 0;
}

.coupon-amount {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.coupon-discount {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.coupon-condition {
  font-size: 20rpx;
  color: #ff9999;
}

.coupon-right {
  flex: 1;
  padding-left: 20rpx;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
}

.coupon-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
}
