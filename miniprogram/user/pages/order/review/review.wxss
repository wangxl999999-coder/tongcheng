.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.service-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.service-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-detail {
  flex: 1;
}

.service-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.service-spec {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.service-time {
  font-size: 24rpx;
  color: #999;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rating-section {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.rating-section .section-title {
  margin-top: 16rpx;
}

.rating-section .section-title:first-child {
  margin-top: 0;
}

.rating-stars {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.star-item {
  padding: 4rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
}

.star-item.active .star {
  color: #ffc107;
}

.rating-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #ff6b6b;
}

.content-section {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.placeholder {
  color: #999;
}

.content-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.images-section {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.images-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: calc(33.33% - 11rpx);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.add-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
  color: #999;
  font-size: 22rpx;
}

.add-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.anonymous-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  width: 100%;
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-submit.disabled {
  background: #ccc;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
