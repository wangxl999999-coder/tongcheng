<view class="container">
  <view class="tabs">
    <view 
      wx:for="{{tabs}}" 
      wx:key="status"
      class="tab-item {{currentTab === item.status ? 'active' : ''}}"
      bindtap="onTabTap"
      data-status="{{item.status}}"
    >
      {{item.label}}
      <view class="tab-bar" wx:if="{{currentTab === item.status}}"></view>
    </view>
  </view>

  <view class="order-list">
    <view 
      class="order-item card" 
      wx:for="{{orders}}" 
      wx:key="id"
      bindtap="onOrderTap"
      data-order="{{item}}"
    >
      <view class="order-header">
        <view class="order-no">订单号：{{item.order_no}}</view>
        <view class="order-status" style="color: {{item.status_color}}">{{item.status_text}}</view>
      </view>

      <view class="order-content">
        <image class="service-cover" src="{{item.service_cover}}" mode="aspectFill"></image>
        <view class="service-info">
          <view class="service-name text-ellipsis">{{item.service_name}}</view>
          <view class="service-spec text-ellipsis" wx:if="{{item.spec_name}}">规格：{{item.spec_name}}</view>
          <view class="order-meta">
            <text wx:if="{{item.technician_name}}">技师：{{item.technician_name}}</text>
            <text wx:if="{{item.service_time}}">时间：{{item.service_time * 1000}}</text>
          </view>
        </view>
        <view class="order-price">
          <text class="price">¥{{item.pay_amount}}</text>
        </view>
      </view>

      <view class="order-actions">
        <view class="action-left" catchtap="onContact" data-order="{{item}}" wx:if="{{item.status >= 2 && item.status <= 4}}">
          <image src="/images/call.png" class="action-icon"></image>
          <text>联系</text>
        </view>
        <view class="action-right">
          <view 
            class="btn btn-outline btn-small" 
            catchtap="onCancel" 
            data-order="{{item}}"
            wx:if="{{item.status === 0 || item.status === 1 || item.status === 2}}"
          >
            取消订单
          </view>
          <view 
            class="btn btn-primary btn-small" 
            catchtap="onPay" 
            data-order="{{item}}"
            wx:if="{{item.status === 0 || item.status === 5}}"
          >
            立即支付
          </view>
          <view 
            class="btn btn-outline btn-small" 
            catchtap="onAddon" 
            data-order="{{item}}"
            wx:if="{{item.status === 3 || item.status === 4}}"
          >
            加项服务
          </view>
          <view 
            class="btn btn-outline btn-small" 
            catchtap="onComplaint" 
            data-order="{{item}}"
            wx:if="{{item.status === 6}}"
          >
            投诉
          </view>
          <view 
            class="btn btn-primary btn-small" 
            catchtap="onReview" 
            data-order="{{item}}"
            wx:if="{{item.status === 6 && !item.is_review}}"
          >
            去评价
          </view>
          <view 
            class="btn btn-gray btn-small" 
            wx:if="{{item.status === 6 && item.is_review}}"
          >
            已评价
          </view>
        </view>
      </view>

      <view class="addon-list" wx:if="{{item.addons && item.addons.length > 0}}">
        <view class="addon-title">加项服务</view>
        <view class="addon-item" wx:for="{{item.addons}}" wx:for-item="addon" wx:key="id">
          <text class="addon-name">{{addon.name}}</text>
          <text class="addon-price">¥{{addon.total}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{orders.length === 0 && !loading}}">
    <image src="/images/empty-order.png"></image>
    <text>暂无订单</text>
    <view class="btn btn-primary" bindtap="goHome">去下单</view>
  </view>

  <view class="loading-more" wx:if="{{loading && orders.length > 0}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>
</view>
