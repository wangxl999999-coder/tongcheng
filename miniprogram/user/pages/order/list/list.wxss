.container {
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: 500;
}

.tab-bar {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.order-list {
  padding: 24rpx;
}

.order-item {
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-content {
  display: flex;
  padding: 20rpx 24rpx;
}

.service-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.service-spec {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0;
}

.order-meta {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.order-meta text {
  display: block;
}

.order-price {
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-price .price {
  font-size: 28rpx;
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f5f5f5;
  background: #fafafa;
}

.action-left {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.action-right {
  display: flex;
  gap: 16rpx;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.addon-list {
  padding: 16rpx 24rpx;
  background: #fff8f0;
  border-top: 1rpx solid #ffecd6;
}

.addon-title {
  font-size: 24rpx;
  color: #ff9500;
  margin-bottom: 8rpx;
}

.addon-item {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  padding: 4rpx 0;
}

.addon-price {
  color: #ff6b6b;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
}

.empty text {
  display: block;
  margin-bottom: 30rpx;
}

.empty .btn {
  display: inline-block;
  padding: 20rpx 60rpx;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
