.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.amount-card {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 30rpx;
}

.amount-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.amount-value {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.amount-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

.order-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row.highlight {
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 2rpx dashed #f0f0f0;
  border-bottom: none;
}

.label {
  color: #666;
  font-size: 28rpx;
}

.value {
  color: #333;
  font-size: 28rpx;
}

.value.price {
  color: #ff6b6b;
  font-weight: bold;
  font-size: 32rpx;
}

.supplement-detail {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.detail-list {
  border-top: 1rpx solid #f5f5f5;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-name {
  font-size: 28rpx;
  color: #333;
}

.detail-amount {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.pay-info {
  display: flex;
  align-items: baseline;
}

.pay-label {
  font-size: 28rpx;
  color: #666;
}

.pay-amount {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-left: 8rpx;
}

.pay-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
}

.pay-btn::after {
  border: none;
}
