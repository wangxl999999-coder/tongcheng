.container {
  padding-bottom: 140rpx;
}

.technician-header {
  position: relative;
  padding-bottom: 30rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.technician-info {
  position: relative;
  display: flex;
  padding: 60rpx 24rpx 30rpx;
  color: #fff;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.tech-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.level-badge {
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: normal;
}

.tech-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.tech-skills {
  font-size: 22rpx;
  opacity: 0.8;
}

.technician-stats {
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.section-more .arrow-right {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
}

.intro-section {
  margin: 24rpx;
  padding: 24rpx;
}

.intro-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.service-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.service-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.service-desc {
  font-size: 22rpx;
  color: #999;
}

.service-right {
  text-align: right;
  flex-shrink: 0;
}

.service-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 8rpx;
}

.btn-small {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.schedule-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.date-scroll {
  white-space: nowrap;
  margin: 0 -24rpx 20rpx;
  padding: 0 24rpx;
}

.date-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.date-item {
  width: 120rpx;
  padding: 16rpx 0;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.date-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.date-week {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.date-month {
  font-size: 22rpx;
  color: #999;
}

.date-item.active .date-week {
  color: #ff6b6b;
}

.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.time-item {
  width: calc(25% - 9rpx);
  padding: 20rpx 0;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
  position: relative;
  box-sizing: border-box;
}

.time-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.time-item.disabled {
  background: #f0f0f0;
  color: #ccc;
}

.time-item .status {
  display: block;
  font-size: 18rpx;
  color: #ff6b6b;
  margin-top: 4rpx;
}

.review-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.review-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.rating-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.rating-stars {
  flex: 1;
  font-size: 24rpx;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-meta text {
  font-size: 20rpx;
}

.review-time {
  color: #999;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding-left: 80rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  font-size: 22rpx;
  color: #666;
}

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.btn-book {
  flex: 1;
  margin-left: 20rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
