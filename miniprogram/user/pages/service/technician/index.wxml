<view class="container" wx:if="{{technician}}">
  <view class="technician-header">
    <view class="header-bg"></view>
    <view class="technician-info">
      <image 
        class="avatar" 
        src="{{technician.avatar || '/images/default-avatar.png'}}"
        bindtap="onPreviewAvatar"
      ></image>
      <view class="info-detail">
        <view class="tech-name">
          {{technician.name}}
          <view class="level-badge" wx:if="{{technician.level_name}}">{{technician.level_name}}</view>
        </view>
        <view class="tech-meta">
          <text>⭐ {{technician.rating || '5.0'}}</text>
          <text>接单{{technician.order_count || 0}}</text>
          <text wx:if="{{technician.distance}}">{{formatDistance(technician.distance)}}</text>
        </view>
        <view class="tech-skills">{{technician.skills}}</view>
      </view>
    </view>
    <view class="technician-stats">
      <view class="stat-item">
        <text class="stat-value">{{technician.order_count || 0}}</text>
        <text class="stat-label">服务单量</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{technician.good_rate || '100'}}%</text>
        <text class="stat-label">好评率</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{technician.work_years || 0}}年</text>
        <text class="stat-label">从业年限</text>
      </view>
    </view>
  </view>

  <view class="intro-section card" wx:if="{{technician.intro}}">
    <view class="section-title">个人简介</view>
    <view class="intro-content">{{technician.intro}}</view>
  </view>

  <view class="service-section card">
    <view class="section-title">服务项目</view>
    <view class="service-list">
      <view 
        wx:for="{{services}}" 
        wx:key="id"
        class="service-item"
        bindtap="onServiceTap"
        data-service="{{item}}"
      >
        <image class="service-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="service-info">
          <view class="service-name">{{item.name}}</view>
          <view class="service-desc">{{item.duration}}分钟</view>
        </view>
        <view class="service-right">
          <view class="service-price">¥{{item.price}}</view>
          <view class="btn btn-small" bindtap="onQuickBook" data-service="{{item}}">预约</view>
        </view>
      </view>
    </view>
  </view>

  <view class="schedule-section card">
    <view class="section-title">可预约时间</view>
    <scroll-view class="date-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="date-list">
        <view 
          wx:for="{{days}}" 
          wx:key="timestamp"
          class="date-item {{currentDayIndex === index ? 'active' : ''}}"
          bindtap="onDayTap"
          data-index="{{index}}"
        >
          <text class="date-week">{{item.week}}</text>
          <text class="date-month">{{item.month}}/{{item.day}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="time-grid">
      <view 
        wx:for="{{times}}" 
        wx:key="time"
        class="time-item {{selectedTime === item.time ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
        bindtap="onTimeTap"
        data-index="{{index}}"
      >
        {{item.time}}
        <text class="status" wx:if="{{item.disabled}}">已约</text>
      </view>
    </view>
  </view>

  <view class="review-section card">
    <view class="section-header">
      <view class="section-title">用户评价</view>
      <view class="section-more">
        全部({{technician.review_count || 0}})
        <image src="/images/arrow-right.png" class="arrow-right"></image>
      </view>
    </view>
    <view class="review-summary">
      <view class="rating-score">{{technician.rating || '5.0'}}</view>
      <view class="rating-stars">
        <text wx:for="{{5}}" wx:key="*this">⭐</text>
      </view>
    </view>
    <view class="review-list">
      <view wx:for="{{reviews}}" wx:key="id" class="review-item">
        <view class="review-header">
          <image class="user-avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}"></image>
          <view class="user-info">
            <view class="user-name">{{item.is_anonymous ? '匿名用户' : item.user_name}}</view>
            <view class="review-meta">
              <text wx:for="{{item.rating}}" wx:for-item="star" wx:key="index">⭐</text>
              <text class="review-time">{{item.created_at * 1000}}</text>
            </view>
          </view>
        </view>
        <view class="review-content">{{item.content}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{reviews.length === 0}}">
      <text>暂无评价</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bar-btn" bindtap="onCall">
      <image src="/images/call.png" class="bar-icon"></image>
      <text>电话联系</text>
    </view>
    <view class="btn btn-primary btn-book" bindtap="onBook">立即预约</view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
