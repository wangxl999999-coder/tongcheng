.container {
  padding-bottom: 40rpx;
}

.search-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-placeholder {
  color: #999;
}

.search-btn {
  padding: 10rpx 24rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin-left: 12rpx;
}

.sort-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sort-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.sort-item.active {
  color: #ff6b6b;
  font-weight: 500;
}

.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ff6b6b;
  border-radius: 2rpx;
}

.service-list {
  padding: 24rpx;
}

.service-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.service-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-header {
  display: flex;
  align-items: center;
}

.service-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.service-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin: 8rpx 0;
}

.service-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  gap: 16rpx;
}

.service-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.service-price {
  display: flex;
  align-items: baseline;
}

.service-price .price {
  font-size: 34rpx;
}

.old-price {
  margin-left: 12rpx;
  font-size: 22rpx;
}

.service-distance {
  font-size: 22rpx;
  color: #ff6b6b;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
