.container {
  padding-bottom: 140rpx;
}

.banner-swiper {
  width: 100%;
  height: 500rpx;
  background: #f0f0f0;
}

.banner-swiper image {
  width: 100%;
  height: 100%;
}

.service-info {
  margin: -40rpx 24rpx 20rpx;
  padding: 24rpx;
  position: relative;
  z-index: 10;
}

.service-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.service-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-right: 20rpx;
}

.service-price {
  flex-shrink: 0;
  text-align: right;
}

.service-price .currency {
  font-size: 24rpx;
  color: #ff6b6b;
}

.service-price .amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.service-price .unit {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.service-sales {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.service-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-item {
  padding: 4rpx 12rpx;
  background: #fff5f5;
  color: #ff6b6b;
  font-size: 20rpx;
  border-radius: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.section-more .arrow-right {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
}

.service-notice {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff9e6 0%, #fff5e6 100%);
  border-left: 6rpx solid #ffc107;
}

.notice-content {
  font-size: 24rpx;
  color: #ff9800;
  line-height: 1.6;
}

.service-desc {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.desc-images image {
  width: 100%;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}

.technician-section {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.technician-scroll {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}

.technician-list {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 24rpx;
}

.technician-item {
  width: 160rpx;
  text-align: center;
  flex-shrink: 0;
}

.tech-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.tech-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.tech-rating {
  font-size: 22rpx;
  color: #ff9500;
  margin-bottom: 4rpx;
}

.tech-orders {
  font-size: 20rpx;
  color: #999;
}

.review-section {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.review-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.rating-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.rating-stars {
  flex: 1;
  font-size: 24rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-meta text {
  font-size: 20rpx;
}

.review-time {
  color: #999;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
  padding-left: 80rpx;
}

.review-images {
  display: flex;
  gap: 12rpx;
  padding-left: 80rpx;
  flex-wrap: wrap;
}

.review-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-actions {
  display: flex;
  gap: 32rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.bar-btns {
  flex: 1;
  display: flex;
  gap: 16rpx;
  margin-left: 32rpx;
}

.bar-btns .btn {
  flex: 1;
  padding: 20rpx;
  font-size: 26rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.spec-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.spec-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  margin-top: -40rpx;
  flex-shrink: 0;
}

.spec-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.spec-price .currency {
  font-size: 24rpx;
  color: #ff6b6b;
}

.spec-price .amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.spec-stock {
  font-size: 24rpx;
  color: #4caf50;
  margin-top: 8rpx;
}

.popup-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}

.popup-content {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.spec-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.spec-item {
  padding: 16rpx 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.spec-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.spec-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.spec-item.active .spec-name {
  color: #ff6b6b;
}

.spec-price-small {
  font-size: 24rpx;
  color: #ff6b6b;
}

.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #333;
}

.type-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.popup-footer {
  padding: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.popup-footer .btn {
  width: 100%;
  padding: 28rpx;
  font-size: 30rpx;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
