.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.category-container {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-left {
  width: 200rpx;
  background: #f8f8f8;
  flex-shrink: 0;
}

.category-item {
  position: relative;
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-bottom: 1rpx solid #eee;
}

.category-item.active {
  background: #fff;
  color: #ff6b6b;
  font-weight: 500;
}

.category-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: #ff6b6b;
  border-radius: 0 4rpx 4rpx 0;
}

.category-right {
  flex: 1;
  background: #fff;
  padding: 24rpx;
}

.right-content {
  padding-bottom: 40rpx;
}

.sub-categories {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.sub-category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.sub-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
}

.sub-name {
  font-size: 22rpx;
  color: #333;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.service-card {
  width: calc(50% - 10rpx);
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
}

.service-cover {
  width: 100%;
  height: 200rpx;
}

.service-info {
  padding: 16rpx;
}

.service-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.service-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.service-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-bottom .price {
  font-size: 28rpx;
}

.service-sales {
  font-size: 22rpx;
  color: #999;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}
