.container {
  padding-bottom: 40rpx;
}

.member-card {
  position: relative;
  margin: 24rpx;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.card-bg::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.card-bg::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.card-content {
  position: relative;
  padding: 30rpx;
  color: #fff;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.level-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.level-badge {
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
}

.level-icon {
  font-size: 28rpx;
}

.member-no {
  font-size: 22rpx;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

.stats-section {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

.progress-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.current-level {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
}

.next-level {
  font-size: 26rpx;
  color: #999;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-tip {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.privilege-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.privilege-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.privilege-item {
  width: calc(33.33% - 11rpx);
  padding: 20rpx 12rpx;
  background: #fafafa;
  border-radius: 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.privilege-item.disabled {
  opacity: 0.4;
}

.privilege-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.privilege-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.privilege-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.4;
}

.levels-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.levels-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.level-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.level-item.current {
  background: linear-gradient(135deg, #fff0f5 0%, #fff5f5 100%);
  border-color: #667eea;
}

.level-item.locked {
  opacity: 0.6;
}

.level-item .level-badge {
  padding: 8rpx 20rpx;
  background: #667eea;
  color: #fff;
  font-size: 22rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.level-item.current .level-badge {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.level-item.locked .level-badge {
  background: #ccc;
}

.level-info {
  flex: 1;
  display: flex;
  gap: 24rpx;
}

.level-condition {
  font-size: 24rpx;
  color: #666;
}

.level-discount {
  font-size: 24rpx;
  color: #ff6b6b;
}

.level-status {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.level-item.current .level-status {
  color: #667eea;
}

.recharge-section {
  padding: 0 24rpx;
}

.btn-recharge {
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
