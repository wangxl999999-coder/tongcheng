<view class="container">
  <view class="form-section card">
    <view class="form-item">
      <text class="label">收货人</text>
      <input 
        placeholder="请输入收货人姓名" 
        placeholder-class="placeholder"
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input 
        type="number"
        placeholder="请输入手机号码" 
        placeholder-class="placeholder"
        value="{{mobile}}"
        bindinput="onMobileInput"
        maxlength="11"
      />
    </view>

    <view class="form-item" bindtap="onRegionPick">
      <text class="label">所在地区</text>
      <picker 
        mode="region" 
        value="{{region}}" 
        bindchange="onRegionChange"
      >
        <view class="picker-content">
          <text wx:if="{{region.length > 0}}" class="picker-value">
            {{region[0]}} {{region[1]}} {{region[2]}}
          </text>
          <text wx:else class="placeholder">请选择省/市/区</text>
          <image src="/images/arrow-right.png" class="arrow-right"></image>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">详细地址</text>
      <textarea 
        placeholder="请输入详细地址，如街道、门牌号等" 
        placeholder-class="placeholder"
        value="{{detail}}"
        bindinput="onDetailInput"
        maxlength="100"
        class="detail-input"
      ></textarea>
    </view>

    <view class="form-item">
      <text class="label">标签</text>
      <view class="tag-list">
        <view 
          wx:for="{{tags}}" 
          wx:key="*this"
          class="tag-item {{currentTagIndex === index ? 'active' : ''}}"
          bindtap="onTagTap"
          data-index="{{index}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">设为默认</text>
      <switch 
        checked="{{isDefault === 1}}" 
        color="#ff6b6b"
        bindchange="onDefaultChange"
      />
    </view>
  </view>

  <view class="btn-group">
    <view class="btn btn-primary btn-block" bindtap="onSave">保存地址</view>
    <view class="btn btn-outline btn-block btn-delete" bindtap="onDelete" wx:if="{{id > 0}}">删除地址</view>
  </view>
</view>
