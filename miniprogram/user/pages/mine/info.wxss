.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.avatar-wrapper {
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #f5f5f5;
}

.camera-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  padding: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.form-section {
  padding: 0;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 88rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-item input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.value-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.value {
  font-size: 28rpx;
  color: #333;
  margin-right: 12rpx;
}

.value.level {
  color: #667eea;
  font-weight: 500;
}

.placeholder {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.arrow-right {
  width: 24rpx;
  height: 24rpx;
}

.gender-group {
  flex: 1;
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.gender-item {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.gender-item.active {
  background: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.save-section {
  padding: 0 24rpx;
}

.btn-block {
  width: 100%;
  padding: 28rpx;
  font-size: 30rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
