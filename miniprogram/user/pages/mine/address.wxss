.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.address-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.address-item.selectable::after {
  content: '>';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 28rpx;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.address-tag {
  padding: 4rpx 12rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.default-tag {
  padding: 4rpx 12rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.address-actions {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

.radio {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  position: relative;
}

.radio.checked {
  border-color: #ff6b6b;
  background: #ff6b6b;
}

.radio.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 18rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.btn-empty {
  width: 60%;
  margin: 0 auto;
}

.add-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
