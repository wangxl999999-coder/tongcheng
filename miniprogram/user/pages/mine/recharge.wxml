<view class="container">
  <view class="user-info card" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}"></image>
    <view class="user-detail">
      <view class="nickname">{{userInfo.nickname}}</view>
      <view class="balance">当前余额：¥{{userInfo.balance ? userInfo.balance.toFixed(2) : '0.00'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">充值套餐</view>
    <view class="package-grid">
      <view 
        wx:for="{{packages}}" 
        wx:key="id"
        class="package-item {{selectedPackageId === item.id ? 'active' : ''}}"
        bindtap="onSelectPackage"
        data-pkg="{{item}}"
      >
        <view class="package-amount">
          <text class="symbol">¥</text>
          <text class="amount">{{item.amount}}</text>
        </view>
        <view class="package-gift" wx:if="{{item.gift_amount > 0}}">
          送 ¥{{item.gift_amount}}
        </view>
        <view class="package-level" wx:if="{{item.gift_level > 0}}">
          送{{item.gift_level_name}}会员
        </view>
        <view class="package-hot" wx:if="{{item.is_hot}}">
          <text>热门</text>
        </view>
        <view class="check-mark" wx:if="{{selectedPackageId === item.id}}">✓</view>
      </view>

      <view 
        class="package-item custom {{isCustom ? 'active' : ''}}"
        bindtap="onCustomTap"
      >
        <view class="custom-content">
          <text class="custom-text" wx:if="{{!isCustom || customAmount <= 0}}">自定义金额</text>
          <input 
            wx:if="{{isCustom}}"
            class="custom-input"
            type="digit"
            placeholder="请输入金额"
            placeholder-class="placeholder"
            value="{{customAmount > 0 ? customAmount : ''}}"
            bindinput="onAmountInput"
            focus="{{isCustom}}"
          />
        </view>
        <view class="check-mark" wx:if="{{isCustom && customAmount > 0}}">✓</view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{selectedPackage}}">
    <view class="section-title">支付方式</view>
    <view class="pay-methods">
      <view 
        class="pay-item {{payType === 1 ? 'active' : ''}}"
        bindtap="onPayTypeTap"
        data-type="1"
      >
        <view class="pay-icon wechat"></view>
        <view class="pay-info">
          <text class="pay-name">微信支付</text>
          <text class="pay-desc">推荐使用，安全快捷</text>
        </view>
        <view class="radio {{payType === 1 ? 'checked' : ''}}"></view>
      </view>
      <view 
        class="pay-item {{payType === 2 ? 'active' : ''}}"
        bindtap="onPayTypeTap"
        data-type="2"
        wx:if="{{userInfo && userInfo.balance >= selectedPackage.amount}}"
      >
        <view class="pay-icon balance"></view>
        <view class="pay-info">
          <text class="pay-name">余额支付</text>
          <text class="pay-desc">当前余额 ¥{{userInfo.balance.toFixed(2)}}</text>
        </view>
        <view class="radio {{payType === 2 ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{selectedPackage}}">
    <view class="section-title">充值明细</view>
    <view class="detail-card">
      <view class="detail-item">
        <text class="detail-label">充值金额</text>
        <text class="detail-value">¥{{selectedPackage.amount.toFixed(2)}}</text>
      </view>
      <view class="detail-item" wx:if="{{selectedPackage.gift_amount > 0}}">
        <text class="detail-label">赠送金额</text>
        <text class="detail-value gift">+¥{{selectedPackage.gift_amount.toFixed(2)}}</text>
      </view>
      <view class="detail-item" wx:if="{{selectedPackage.gift_level_name}}">
        <text class="detail-label">赠送会员</text>
        <text class="detail-value gift">{{selectedPackage.gift_level_name}}</text>
      </view>
      <view class="detail-item total">
        <text class="detail-label">实付金额</text>
        <text class="detail-value total-amount">¥{{selectedPackage.amount.toFixed(2)}}</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-info">
      <text class="total-label">应付：</text>
      <text class="total-amount" wx:if="{{selectedPackage}}">¥{{selectedPackage.amount.toFixed(2)}}</text>
      <text class="total-amount" wx:else>¥0.00</text>
    </view>
    <view 
      class="btn btn-primary btn-recharge {{!selectedPackage || selectedPackage.amount <= 0 ? 'disabled' : ''}}"
      bindtap="onRecharge"
    >
      立即充值
    </view>
  </view>

  <view class="agreement">
    <text>充值即代表同意《用户充值协议》</text>
  </view>
</view>
