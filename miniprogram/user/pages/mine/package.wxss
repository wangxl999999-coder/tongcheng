.container {
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b6b;
  border-radius: 3rpx;
}

.package-list {
  padding: 24rpx;
}

.package-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.package-item.disabled {
  opacity: 0.6;
}

.package-cover {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  flex-shrink: 0;
}

.package-cover image {
  width: 100%;
  height: 100%;
}

.package-times {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  text-align: center;
  color: #fff;
}

.package-times .remaining {
  font-size: 32rpx;
  font-weight: bold;
}

.package-times .total {
  font-size: 22rpx;
  opacity: 0.9;
}

.package-info {
  flex: 1;
  padding: 20rpx;
}

.package-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.package-service {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.package-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.package-meta .price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.package-meta .validity {
  font-size: 22rpx;
  color: #999;
}

.package-action {
  padding: 20rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
  writing-mode: vertical-rl;
  text-align: center;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.package-status {
  padding: 20rpx;
  background: #ccc;
  color: #fff;
  font-size: 24rpx;
  writing-mode: vertical-rl;
  text-align: center;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.load-more {
  padding: 40rpx 0;
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.detail-popup {
  position: fixed;
  top: 50%;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}

.popup-content {
  flex: 1;
}

.detail-cover {
  width: 100%;
  height: 360rpx;
}

.detail-info {
  padding: 24rpx;
}

.detail-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.detail-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.detail-price .price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-right: 16rpx;
}

.detail-price .times {
  font-size: 26rpx;
  color: #999;
}

.detail-progress {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b 0%, #ee5a6f 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.detail-section {
  margin-bottom: 24rpx;
}

.detail-section .section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.detail-section .section-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-actions .btn {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
}
