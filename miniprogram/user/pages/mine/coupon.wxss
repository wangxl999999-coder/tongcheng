.container {
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b6b;
  border-radius: 3rpx;
}

.redeem-btn {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.redeem-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.redeem-btn text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow-right {
  width: 24rpx;
  height: 24rpx;
}

.coupon-list {
  padding: 0 24rpx;
}

.coupon-item {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.coupon-item.disabled {
  opacity: 0.6;
}

.coupon-left {
  width: 200rpx;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.coupon-item.disabled .coupon-left {
  background: linear-gradient(135deg, #ccc 0%, #bbb 100%);
}

.coupon-left::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 0;
  bottom: 0;
  width: 16rpx;
  background-image: radial-gradient(circle, #f5f5f5 8rpx, transparent 8rpx);
  background-size: 16rpx 16rpx;
  background-position: 0 50%;
}

.coupon-amount {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.coupon-discount {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.coupon-condition {
  font-size: 20rpx;
  opacity: 0.9;
}

.coupon-right {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
}

.coupon-status {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 6rpx 16rpx;
  background: #f0f0f0;
  color: #999;
  font-size: 20rpx;
  border-radius: 16rpx;
}

.coupon-use {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #ccc;
}

.load-more {
  padding: 40rpx 0;
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.code-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 1000;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
}

.popup-content {
  padding: 40rpx;
}

.code-input {
  width: 100%;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
  margin-bottom: 30rpx;
}

.placeholder {
  color: #ccc;
}

.btn-redeem {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
}
