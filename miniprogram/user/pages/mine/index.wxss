.container {
  padding-bottom: 40rpx;
}

.header {
  position: relative;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx;
  color: #fff;
}

.user-info.no-login {
  justify-content: flex-start;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
}

.user-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.level-badge {
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 20rpx;
}

.user-mobile {
  font-size: 24rpx;
  opacity: 0.9;
}

.bind-mobile {
  color: #ffe082;
  font-size: 24rpx;
}

.login-tip {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.login-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

.arrow-right {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.wallet-info {
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.wallet-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.wallet-item + .wallet-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

.wallet-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 4rpx;
}

.wallet-label {
  font-size: 24rpx;
  color: #999;
}

.wallet-recharge {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.order-section {
  margin: 24rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.section-more .arrow-right {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.order-tabs {
  display: flex;
}

.order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-icon-wrapper {
  position: relative;
  margin-bottom: 8rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
}

.menu-section {
  padding: 0 24rpx;
}

.menu-group {
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.login-prompt {
  margin: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.prompt-text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.login-prompt .btn {
  width: 80%;
  margin: 0 auto;
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 20rpx;
}

.app-logo {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

.app-name {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.app-version {
  font-size: 22rpx;
  color: #ccc;
}
