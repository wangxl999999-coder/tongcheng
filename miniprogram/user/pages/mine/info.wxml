<view class="container" wx:if="{{!loading}}">
  <view class="avatar-section card" bindtap="onChooseAvatar">
    <view class="section-label">头像</view>
    <view class="avatar-wrapper">
      <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}"></image>
      <image src="/images/camera.png" class="camera-icon"></image>
    </view>
  </view>

  <view class="form-section card">
    <view class="form-item">
      <text class="label">昵称</text>
      <input 
        placeholder="请输入昵称" 
        placeholder-class="placeholder"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <view class="value-wrapper" bindtap="onBindMobile">
        <text wx:if="{{userInfo.mobile}}" class="value">{{userInfo.mobile.replace(/(\d{3})\d{4}(\d{4})/, '$1****$2')}}</text>
        <text wx:else class="placeholder">点击绑定手机号</text>
        <image src="/images/arrow-right.png" class="arrow-right"></image>
      </view>
    </view>

    <view class="form-item">
      <text class="label">性别</text>
      <view class="gender-group">
        <view 
          class="gender-item {{gender === 0 ? 'active' : ''}}"
          bindtap="onGenderTap"
          data-gender="0"
        >
          保密
        </view>
        <view 
          class="gender-item {{gender === 1 ? 'active' : ''}}"
          bindtap="onGenderTap"
          data-gender="1"
        >
          男
        </view>
        <view 
          class="gender-item {{gender === 2 ? 'active' : ''}}"
          bindtap="onGenderTap"
          data-gender="2"
        >
          女
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">生日</text>
      <picker 
        mode="date" 
        value="{{birthday}}" 
        bindchange="onBirthdayChange"
        start="1900-01-01"
        end="2025-12-31"
      >
        <view class="value-wrapper">
          <text wx:if="{{birthday}}" class="value">{{birthday}}</text>
          <text wx:else class="placeholder">请选择生日</text>
          <image src="/images/arrow-right.png" class="arrow-right"></image>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">会员等级</text>
      <view class="value-wrapper">
        <text class="value level">{{userInfo.level_name || '普通会员'}}</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">注册时间</text>
      <view class="value-wrapper">
        <text class="value">{{userInfo.created_at * 1000}}</text>
      </view>
    </view>
  </view>

  <view class="save-section">
    <view class="btn btn-primary btn-block" bindtap="onSave">保存</view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
