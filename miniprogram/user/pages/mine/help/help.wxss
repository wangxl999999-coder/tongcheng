.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.help-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.help-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.help-item:last-child {
  border-bottom: none;
}

.help-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
}

.help-title {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.arrow {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.3s;
}

.arrow.up {
  transform: rotate(180deg);
}

.help-content {
  padding: 0 30rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.contact-section {
  margin-top: 60rpx;
  text-align: center;
}

.contact-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.contact-btn {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 80rpx;
  height: 80rpx;
  line-height: 76rpx;
  display: inline-block;
}

.contact-btn::after {
  border: none;
}
