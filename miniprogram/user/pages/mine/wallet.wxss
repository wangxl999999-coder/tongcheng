.container {
  padding-bottom: 40rpx;
}

.balance-card {
  position: relative;
  margin: 24rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  border-radius: 20rpx;
  overflow: hidden;
}

.balance-bg {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.balance-content {
  position: relative;
  color: #fff;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  letter-spacing: 2rpx;
}

.balance-info {
  display: flex;
  gap: 60rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.info-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.balance-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 24rpx;
}

.tabs {
  display: flex;
  background: #fff;
  margin: 0 24rpx 20rpx;
  padding: 12rpx;
  border-radius: 16rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #ff6b6b;
  color: #fff;
  font-weight: 500;
}

.records-list {
  padding: 0 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}

.record-left {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.record-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: #ccc;
}

.record-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.record-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.record-amount.plus {
  color: #4caf50;
}

.record-amount.minus {
  color: #ff6b6b;
}

.record-balance {
  font-size: 22rpx;
  color: #999;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.load-more {
  padding: 40rpx 0;
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
}
