<view class="container">
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === item.id ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTabChange"
    >
      {{item.name}}
    </view>
  </view>

  <view class="order-list" wx:if="{{!loading}}">
    <view 
      class="order-item" 
      wx:for="{{orderList}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOrderDetail"
    >
      <view class="order-header">
        <view class="order-no">{{item.order_no}}</view>
        <view class="order-status" style="color: {{item.status_color}}">
          {{item.status_text}}
        </view>
      </view>

      <view class="service-info">
        <image class="service-image" src="{{item.service_image}}" mode="aspectFill"></image>
        <view class="service-detail">
          <view class="service-name">{{item.service_name}}</view>
          <view class="service-spec" wx:if="{{item.spec_name}}">{{item.spec_name}}</view>
          <view class="appointment-time">
            <text>⏰ {{item.appointment_time}}</text>
          </view>
          <view class="address" wx:if="{{item.address}}">
            <text>📍 {{item.address}}</text>
          </view>
        </view>
      </view>

      <view class="user-info">
        <image class="user-avatar" src="{{item.user_avatar}}" mode="aspectFill"></image>
        <view class="user-detail">
          <view class="user-name">{{item.user_name}}</view>
          <view class="user-phone">{{item.user_phone}}</view>
        </view>
        <view class="order-amount">
          <text class="price">¥{{item.amount}}</text>
        </view>
      </view>

      <view class="order-actions" catchtap="noop">
        <button 
          class="action-btn secondary" 
          wx:if="{{item.status === 2}}"
          catchtap="onAcceptOrder"
          data-id="{{item.id}}"
        >
          接受订单
        </button>
        <button 
          class="action-btn primary" 
          wx:if="{{item.status === 3}}"
          catchtap="onStartService"
          data-id="{{item.id}}"
        >
          开始服务
        </button>
        <button 
          class="action-btn primary" 
          wx:if="{{item.status === 4}}"
          catchtap="onCompleteService"
          data-id="{{item.id}}"
        >
          完成服务
        </button>
        <button 
          class="action-btn secondary" 
          wx:if="{{item.status >= 2 && item.status <= 4}}"
          catchtap="onCallUser"
          data-phone="{{item.user_phone}}"
        >
          联系用户
        </button>
        <button 
          class="action-btn secondary" 
          wx:if="{{item.status >= 2 && item.status <= 4 && item.address}}"
          catchtap="onNavigate"
          data-address="{{item.address}}"
        >
          导航前往
        </button>
      </view>
    </view>

    <view class="empty" wx:if="{{orderList.length === 0}}">
      <text>暂无订单</text>
    </view>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && orderList.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
