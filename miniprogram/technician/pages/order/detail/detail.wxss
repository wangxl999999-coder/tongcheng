.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.status-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.status-icon {
  font-size: 64rpx;
  margin-right: 30rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.service-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.service-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.service-spec {
  font-size: 24rpx;
  color: #999;
}

.service-price {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: #999;
}

.contact-btn {
  background: #e3f2fd;
  color: #2196f3;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 56rpx;
  line-height: 56rpx;
  border: none;
}

.contact-btn::after {
  border: none;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #999;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  text-align: right;
  flex: 1;
  padding-left: 20rpx;
  word-break: break-all;
}

.info-value.address {
  line-height: 1.5;
}

.info-value.copy {
  color: #ff6b6b;
}

.info-value.discount {
  color: #4caf50;
}

.info-value.price {
  color: #ff6b6b;
  font-weight: bold;
  font-size: 32rpx;
}

.info-row.total {
  padding-top: 20rpx;
}

.divider {
  height: 1rpx;
  background: #f5f5f5;
  margin: 10rpx 0;
}

.nav-btn {
  width: 100%;
  background: #fff;
  color: #2196f3;
  border: 2rpx solid #2196f3;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 68rpx;
  margin-top: 16rpx;
}

.nav-btn::after {
  border: none;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
