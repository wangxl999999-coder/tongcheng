.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 40rpx 30rpx;
  color: #fff;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.income-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.income-value {
  font-size: 64rpx;
  font-weight: bold;
}

.withdraw-btn {
  background: #fff;
  color: #ff6b6b;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
}

.withdraw-btn::after {
  border: none;
}

.header-bottom {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 30rpx 0;
}

.income-item {
  flex: 1;
  text-align: center;
}

.item-value {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.item-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.stats-cards {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-top: -20rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 28rpx;
}

.section {
  padding: 0 20rpx;
}

.section-header {
  padding: 20rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #ff6b6b;
  color: #fff;
}

.income-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.income-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.income-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.item-amount {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.item-amount.income {
  color: #4caf50;
}

.item-status {
  font-size: 22rpx;
  color: #4caf50;
}

.item-status.pending {
  color: #ff9800;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
