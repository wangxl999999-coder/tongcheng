.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding-bottom: 40rpx;
  color: #fff;
}

.status-bar {
  height: var(--status-bar-height, 44px);
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 30rpx;
}

.info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
}

.online-switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch {
  width: 80rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 22rpx;
  padding: 3rpx;
  transition: all 0.3s;
}

.switch.on {
  background: #4caf50;
}

.switch-dot {
  width: 38rpx;
  height: 38rpx;
  background: #fff;
  border-radius: 50%;
  transition: all 0.3s;
}

.switch.on .switch-dot {
  transform: translateX(36rpx);
}

.switch-text {
  font-size: 24rpx;
}

.level-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone {
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  margin: 0 30rpx;
  padding: 30rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
}

.menu-section {
  padding: 20rpx;
  margin-top: 20rpx;
}

.menu-group {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.3s;
}

.menu-item:active {
  background: #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  width: 100%;
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 84rpx;
}

.logout-btn::after {
  border: none;
}

.version-info {
  text-align: center;
  padding: 20rpx 0 40rpx;
  font-size: 24rpx;
  color: #999;
}
